# Anthropic (Claude API)
# 값이 없으면 SDK가 `ant auth login` 프로필을 자동으로 사용합니다.
ANTHROPIC_API_KEY=

# Supabase (Project Settings > API 에서 확인)
SUPABASE_URL=
SUPABASE_ANON_KEY=
                 # 사용자 토큰으로 RLS를 적용해 대신 요청할 때 사용
SUPABASE_SERVICE_ROLE_KEY=
     # 백엔드 전용 (RLS 우회, 절대 클라이언트에 노출 금지, 절대 git에 커밋 금지)

# 서버
PORT=4001

# FCM (Firebase Cloud Messaging) - Push
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# 이메일 인증번호 발송 (SMTP - 예: Gmail은 SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, 앱 비밀번호 사용)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS / 카카오 알림톡 (Solapi 예시 - 국내 대표 알림톡 대행사)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=                # 발신번호 사전등록 필요
SOLAPI_KAKAO_PF_ID=                 # 카카오 비즈니스 채널 ID
SOLAPI_KAKAO_TEMPLATE_ID=           # 사전 승인된 알림톡 템플릿 ID
